# Postgres connection string (Neon or any Postgres-compatible host). Must use
# the asyncpg driver and request SSL, matching how app/db.py builds its engine.
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# Redis connection string (Upstash or any Redis-compatible host). Backs the
# session risk ledger (app/redis_client.py) with a 15-minute TTL per session.
REDIS_URL=rediss://default:password@your-project.upstash.io:6379

# Base URL of an OpenAI-compatible chat completions API. This project was
# built and tested against a local Ollama instance.
MODEL_API_BASE_URL=http://localhost:11434/v1

# Optional. Only needed if MODEL_API_BASE_URL points at a provider that
# requires an API key (e.g. a hosted API). Leave blank for local Ollama.
MODEL_API_KEY=
